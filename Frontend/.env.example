# Để trống VITE_API_URL khi chạy Vite dev proxy; đặt URL API khi build tách riêng frontend.
VITE_API_URL=

# Phải trùng với GoogleAuth:ClientId của backend.
VITE_GOOGLE_CLIENT_ID=

# Đường dẫn file cài đặt app Android. Để trống → nút tải hiện "File cài đặt sắp có".
# VD: đặt file vào public/downloads/stayluxe.apk rồi khai báo /downloads/stayluxe.apk
VITE_ANDROID_APK_URL=
# Ảnh mã QR trỏ tới file APK (tùy chọn). VD /downloads/stayluxe-qr.png
VITE_ANDROID_APK_QR=
