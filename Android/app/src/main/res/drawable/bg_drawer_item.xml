<?xml version="1.0" encoding="utf-8"?>
<!-- Mục menu dạng viên thuốc, mục đang chọn nền primary-container như sidebar web. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset android:insetLeft="12dp" android:insetRight="12dp" android:insetTop="2dp" android:insetBottom="2dp">
            <shape>
                <solid android:color="@color/md_primary_container" />
                <corners android:radius="999dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="12dp" android:insetRight="12dp" android:insetTop="2dp" android:insetBottom="2dp">
            <shape>
                <solid android:color="@android:color/transparent" />
                <corners android:radius="999dp" />
            </shape>
        </inset>
    </item>
</selector>
