<?xml version="1.0" encoding="utf-8"?>
<!-- Tổng quan kinh doanh: chọn kỳ -> 4 chỉ số (2x2) -> biểu đồ doanh thu theo ngày -> công suất phòng. -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupPeriod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/period_7" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip30"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="true"
                    android:text="@string/period_30" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip90"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/period_90" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/tvRange"
                style="@style/SecondaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <include android:id="@+id/kpiRevenue" layout="@layout/view_kpi_card" />
                <include android:id="@+id/kpiOccupancy" layout="@layout/view_kpi_card" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <include android:id="@+id/kpiBookings" layout="@layout/view_kpi_card" />
                <include android:id="@+id/kpiCancel" layout="@layout/view_kpi_card" />
            </LinearLayout>

            <!-- Biểu đồ doanh thu -->
            <com.google.android.material.card.MaterialCardView
                style="@style/SectionCard"
                android:layout_marginHorizontal="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/revenue_by_day" />

                    <TextView
                        android:id="@+id/tvPeak"
                        style="@style/SecondaryText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:textSize="12sp" />

                    <com.example.hotelbookingandroid.ui.portal.admin.BarChartView
                        android:id="@+id/chart"
                        android:layout_width="match_parent"
                        android:layout_height="180dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Công suất phòng -->
            <com.google.android.material.card.MaterialCardView
                style="@style/SectionCard"
                android:layout_marginHorizontal="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/room_nights" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressOccupancy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        app:indicatorColor="@color/md_primary_container"
                        app:trackColor="@color/md_surface_container_high"
                        app:trackCornerRadius="999dp"
                        app:trackThickness="10dp" />

                    <TextView
                        android:id="@+id/tvRoomNights"
                        style="@style/SecondaryText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
