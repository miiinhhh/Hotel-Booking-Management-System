Ref FK_Notifications_User: Notifications.UserId > Users.UserId [delete: cascade]
Ref FK_Payments_Booking: Payments.BookingId > Bookings.BookingId
Ref FK_PriceSurgeRules_CreatedByUser: PriceSurgeRules.CreatedByUserId > Users.UserId
Ref FK_PriceSurgeRules_Hotel: PriceSurgeRules.HotelId > Hotels.HotelId
Ref FK_PriceSurgeRules_RoomType: PriceSurgeRules.RoomTypeId > RoomTypes.RoomTypeId
