Ref FK_ReviewModerationHistory_Actor: ReviewModerationHistory.ActorId > Users.UserId
Ref FK_ReviewModerationHistory_Review: ReviewModerationHistory.ReviewId > Reviews.ReviewId
Ref FK_Reviews_Booking: Reviews.BookingId > Bookings.BookingId
Ref FK_Reviews_Customer: Reviews.CustomerId > Users.UserId
Ref FK_RolePermissions_Permission: RolePermissions.PermissionId > Permissions.PermissionId [delete: cascade]
Ref FK_RolePermissions_Role: RolePermissions.RoleId > Roles.RoleId [delete: cascade]
Ref FK_RoomAmenities_Amenity: RoomAmenities.AmenityId > Amenities.AmenityId [delete: cascade]
Ref FK_RoomAmenities_Room: RoomAmenities.RoomId > Rooms.RoomId [delete: cascade]
Ref FK_RoomEmergencyLocks_Creator: RoomEmergencyLocks.CreatedByUserId > Users.UserId
Ref FK_RoomEmergencyLocks_Hotel: RoomEmergencyLocks.HotelId > Hotels.HotelId
Ref FK_RoomEmergencyLocks_Releaser: RoomEmergencyLocks.ReleasedByUserId > Users.UserId
Ref FK_RoomEmergencyLocks_Room: RoomEmergencyLocks.RoomId > Rooms.RoomId
Ref FK_RoomImages_Room: RoomImages.RoomId > Rooms.RoomId [delete: cascade]
Ref FK_RoomPriceHistory_RoomType: RoomPriceHistory.RoomTypeId > RoomTypes.RoomTypeId
Ref FK_RoomPriceHistory_User: RoomPriceHistory.ChangedByUserId > Users.UserId
Ref FK_Rooms_Area: Rooms.AreaId > HotelAreas.AreaId
Ref FK_Rooms_RoomType: Rooms.RoomTypeId > RoomTypes.RoomTypeId
Ref FK_RoomTypes_Area: RoomTypes.AreaId > HotelAreas.AreaId
Ref FK_RoomTypes_Hotel: RoomTypes.HotelId > Hotels.HotelId
Ref FK_StaffAreaAssignments_Area: StaffAreaAssignments.AreaId > HotelAreas.AreaId
Ref FK_StaffAreaAssignments_AssignedBy: StaffAreaAssignments.AssignedByUserId > Users.UserId
Ref FK_StaffAreaAssignments_User: StaffAreaAssignments.UserId > Users.UserId
