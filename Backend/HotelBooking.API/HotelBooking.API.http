@HotelBooking.API_HostAddress = https://localhost:7131

### Register a Customer
POST {{HotelBooking.API_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Nguyen Van A",
  "email": "customer@example.com",
  "password": "StrongPassword123!",
  "phone": "0900000000"
}

### Login
POST {{HotelBooking.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "customer@example.com",
  "password": "StrongPassword123!"
}

### Authenticated profile (replace token)
GET {{HotelBooking.API_HostAddress}}/api/me
Authorization: Bearer {{accessToken}}

### Staff-only resource
GET {{HotelBooking.API_HostAddress}}/api/staff
Authorization: Bearer {{accessToken}}

### Admin-only resource
GET {{HotelBooking.API_HostAddress}}/api/admin
Authorization: Bearer {{accessToken}}

###
@baseUrl = http://localhost:5131
@hotelId = 1
@areaId = 1
@roomTypeId = 1
@roomId = 1

### Create amenity (Admin JWT)
POST {{baseUrl}}/api/amenities
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Wi-Fi",
  "description": "Internet mien phi"
}

### List active amenities
GET {{baseUrl}}/api/amenities

### Assign amenity to Hotel (replace ID)
PUT {{baseUrl}}/api/hotels/{{hotelId}}/amenities/1
Authorization: Bearer {{accessToken}}

### Assign amenity to Room
PUT {{baseUrl}}/api/hotels/{{hotelId}}/rooms/{{roomId}}/amenities/1
Authorization: Bearer {{accessToken}}

### Remove amenity from Room
DELETE {{baseUrl}}/api/hotels/{{hotelId}}/rooms/{{roomId}}/amenities/1
Authorization: Bearer {{accessToken}}

### Upload Hotel image: replace local-image.png with a real JPEG/PNG/WebP path
POST {{baseUrl}}/api/hotels/{{hotelId}}/images
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=hotel-image-boundary

--hotel-image-boundary
Content-Disposition: form-data; name="file"; filename="hotel.png"
Content-Type: image/png

< ./local-image.png
--hotel-image-boundary
Content-Disposition: form-data; name="isPrimary"

true
--hotel-image-boundary--

### List Room images
GET {{baseUrl}}/api/hotels/{{hotelId}}/rooms/{{roomId}}/images

### Select primary image (replace image ID)
PUT {{baseUrl}}/api/hotels/{{hotelId}}/images/1/primary
Authorization: Bearer {{accessToken}}

### Reorder all Hotel images (replace IDs)
PUT {{baseUrl}}/api/hotels/{{hotelId}}/images/order
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "imageIds": [2, 1] }

### Delete image
DELETE {{baseUrl}}/api/hotels/{{hotelId}}/images/1
Authorization: Bearer {{accessToken}}

### Public room search: name + inclusive reference price + pagination
GET {{baseUrl}}/api/hotels/{{hotelId}}/rooms/search?roomTypeName=deluxe&minPrice=500000&maxPrice=900000&pageNumber=1&pageSize=20

### Public room search: all currently available and visible rooms
GET {{baseUrl}}/api/hotels/{{hotelId}}/rooms/search

### No matching rooms: 200 with empty items and message
GET {{baseUrl}}/api/hotels/{{hotelId}}/rooms/search?roomTypeName=does-not-exist

### Invalid price range: 400 ProblemDetails
GET {{baseUrl}}/api/hotels/{{hotelId}}/rooms/search?minPrice=900000&maxPrice=500000

### Create type (replace IDs with existing active hotel / area)
POST {{baseUrl}}/api/hotels/{{hotelId}}/areas/{{areaId}}/room-types
Content-Type: application/json

{
  "name": "Deluxe",
  "description": "Phong hai nguoi",
  "basePrice": 500000,
  "capacity": 2,
  "numberOfBeds": 1
}

### List types
GET {{baseUrl}}/api/hotels/{{hotelId}}/room-types

### Get type
GET {{baseUrl}}/api/hotels/{{hotelId}}/room-types/{{roomTypeId}}

### Update type price and capacity
PUT {{baseUrl}}/api/hotels/{{hotelId}}/room-types/{{roomTypeId}}
Content-Type: application/json

{
  "name": "Deluxe",
  "description": null,
  "basePrice": 750000,
  "capacity": 3,
  "numberOfBeds": 2
}

### Create room
POST {{baseUrl}}/api/hotels/{{hotelId}}/areas/{{areaId}}/rooms
Content-Type: application/json

{
  "roomTypeId": {{roomTypeId}},
  "roomNumber": "101",
  "floor": 1,
  "status": "Available",
  "description": null
}

### List rooms
GET {{baseUrl}}/api/hotels/{{hotelId}}/rooms

### Get room
GET {{baseUrl}}/api/hotels/{{hotelId}}/rooms/{{roomId}}

### Update room
PUT {{baseUrl}}/api/hotels/{{hotelId}}/rooms/{{roomId}}
Content-Type: application/json

{
  "roomTypeId": {{roomTypeId}},
  "roomNumber": "101",
  "floor": 1,
  "status": "Maintenance",
  "description": "Bao tri"
}

### Deactivate room before deactivating its type
DELETE {{baseUrl}}/api/hotels/{{hotelId}}/rooms/{{roomId}}

### Deactivate type
DELETE {{baseUrl}}/api/hotels/{{hotelId}}/room-types/{{roomTypeId}}

### Calculate Booking Price (Preview / Quote with Voucher)
POST {{baseUrl}}/api/bookings/calculate-price
Content-Type: application/json

{
  "checkInDate": "2026-11-01",
  "checkOutDate": "2026-11-04",
  "roomIds": [1],
  "voucherCode": "LUXE2026",
  "paymentMethod": "Deposit"
}

### Create Booking (Authoritative pricing calculated on server)
POST {{baseUrl}}/api/bookings
Content-Type: application/json

{
  "checkInDate": "2026-11-01",
  "checkOutDate": "2026-11-04",
  "numberOfGuests": 2,
  "paymentMethod": "Deposit",
  "voucherCode": "LUXE2026",
  "specialRequests": "Tầng cao hướng biển, giường King",
  "rooms": [
    {
      "roomId": 1
    }
  ],
  "guests": [
    {
      "fullName": "Nguyen Van An",
      "phone": "0912345678",
      "email": "an.nguyen@example.com",
      "isPrimaryGuest": true
    }
  ]
}

### Get all Areas of Hotel (with room stats)
GET {{baseUrl}}/api/hotels/{{hotelId}}/staff-assignments/areas

### Get all Staff Members and their assigned areas
GET {{baseUrl}}/api/hotels/{{hotelId}}/staff-assignments

### Sync Staff Assigned Areas (Assign/Reassign multiple areas to a staff member)
PUT {{baseUrl}}/api/hotels/{{hotelId}}/staff-assignments/sync
Content-Type: application/json

{
  "userId": 2,
  "areaIds": [1, 2]
}

### Remove a specific assignment
DELETE {{baseUrl}}/api/hotels/{{hotelId}}/staff-assignments/1

### Get assigned areas for current staff member (Staff Portal - Active Zone)
GET {{baseUrl}}/api/staff/me/assigned-areas?userId=2

