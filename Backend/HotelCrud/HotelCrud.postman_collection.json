{
  "info": {
    "name": "Hotel CRUD - Clean Architecture",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order against your local development database. Creates one test Hotel and deletes it. SQL Server configuration is documented in README.md."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:7260",
      "type": "string"
    },
    {
      "key": "hotelId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Create Hotel",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/hotels",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hotelName\": \"Hotel CRUD Test\",\n  \"description\": \"Tạo từ Postman\",\n  \"address\": \"123 Nguyễn Huệ\",\n  \"city\": \"Hồ Chí Minh\",\n  \"country\": \"Vietnam\",\n  \"phone\": \"0901234567\",\n  \"email\": \"hotel@example.com\",\n  \"website\": \"https://example.com\",\n  \"checkInTime\": \"14:00:00\",\n  \"checkOutTime\": \"12:00:00\",\n  \"isActive\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const hotel = pm.response.json(); pm.collectionVariables.set(\"hotelId\", hotel.hotelId);",
              "pm.test(\"Generated ID\", () => pm.expect(hotel.hotelId).to.be.above(0));",
              "pm.test(\"Location header\", () => pm.response.to.have.header(\"Location\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Read Hotel",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/hotels/{{hotelId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Correct Hotel\", () => pm.expect(pm.response.json().hotelName).to.eql(\"Hotel CRUD Test\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 List Hotels",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/hotels?pageNumber=1&pageSize=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Page shape\", () => { const page = pm.response.json(); pm.expect(page.items).to.be.an(\"array\"); pm.expect(page.totalCount).to.be.at.least(1); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Update Hotel",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/hotels/{{hotelId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hotelName\": \"Hotel Updated\",\n  \"description\": \"Tạo từ Postman\",\n  \"address\": \"123 Nguyễn Huệ\",\n  \"city\": \"Hồ Chí Minh\",\n  \"country\": \"Vietnam\",\n  \"phone\": \"0901234567\",\n  \"email\": \"hotel@example.com\",\n  \"website\": \"https://example.com\",\n  \"checkInTime\": \"14:00:00\",\n  \"checkOutTime\": \"12:00:00\",\n  \"isActive\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Updated timestamp\", () => pm.expect(pm.response.json().updatedAt).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Verify update persisted",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/hotels/{{hotelId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Updated values\", () => { const hotel = pm.response.json(); pm.expect(hotel.hotelName).to.eql(\"Hotel Updated\"); pm.expect(hotel.isActive).to.eql(false); });"
            ]
          }
        }
      ]
    },
    {
