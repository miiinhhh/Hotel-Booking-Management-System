    {
      "name": "16 OpenAPI lists Hotel endpoints",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/openapi/v1.json"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Hotel endpoints documented\", () => { const paths = pm.response.json().paths; pm.expect(paths[\"/api/hotels\"].post).to.exist; pm.expect(paths[\"/api/hotels/{hotelId}\"].delete).to.exist; });"
            ]
          }
        }
      ]
    }
  ]
