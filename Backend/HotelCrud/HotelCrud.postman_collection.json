        "url": "{{baseUrl}}/api/hotels",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hotelName\": \"   \",\n  \"description\": \"Tạo từ Postman\",\n  \"address\": \"123 Nguyễn Huệ\",\n  \"city\": \"Hồ Chí Minh\",\n  \"country\": \"Vietnam\",\n  \"phone\": \"0901234567\",\n  \"email\": \"hotel@example.com\",\n  \"website\": \"https://example.com\",\n  \"checkInTime\": \"14:00:00\",\n  \"checkOutTime\": \"12:00:00\",\n  \"isActive\": true\n}",
          "options": {
